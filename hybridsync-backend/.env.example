# Your Bot Token (Starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Your App-Level Token for Socket Mode (Starts with xapp-)
SLACK_APP_TOKEN=xapp-your-app-token-here

# AI Provider — set ONE of the two below (Anthropic takes priority if both are set)
# Anthropic: get key at console.anthropic.com (starts with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Groq: get key at console.groq.com (starts with gsk_)
GROQ_API_KEY=gsk_your-groq-key-here

# Firebase — path to your service account JSON file (unused when Supabase is active)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Supabase — get both values from supabase.com → project → Settings → API
# Use the service_role key (not anon) — this is backend-only, never exposed to browsers
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# Auth — dashboard login credentials
JWT_SECRET=replace-with-a-long-random-string
HR_PASSWORD=replace-with-strong-password
MANAGER_PASSWORD=replace-with-strong-password

# Slack OAuth — for syncing HybridSync status to Slack profile
# Get Client ID + Secret from: api.slack.com/apps → your app → Basic Information → App Credentials
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
# Redirect URI must match exactly what's added in Slack app → OAuth & Permissions → Redirect URLs
SLACK_OAUTH_REDIRECT_URI=https://your-domain.example.com/api/oauth/callback

# Google Calendar OAuth — get from console.cloud.google.com → APIs & Services → Credentials
# Scopes required: calendar.readonly + userinfo.email
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.example.com/api/google/callback

# Slack Sign in with Slack — dashboard login
# Comma-separated Slack user IDs granted HR-level dashboard access
HR_SLACK_IDS=U0XXXXXXXXX
BACKEND_URL=https://your-domain.example.com
FRONTEND_URL=https://your-frontend.example.com
